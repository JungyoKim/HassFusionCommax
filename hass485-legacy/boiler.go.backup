package main

import (
	"fmt"
	"strconv"
	"strings"
	"sync"
	"time"

	mqtt "github.com/eclipse/paho.mqtt.golang"
	"github.com/tarm/serial"
)

// ?�수 ?�의
const (
	MaxRooms          = 4
	SerialBaudRate    = 9600
	SerialReadTimeout = 100 * time.Millisecond
	CommandDelay      = 75 * time.Millisecond
	StatusQueryDelay  = 75 * time.Millisecond

	MinTemp = 0x05
	MaxTemp = 0x35

	StatusResponseHeader  = 0x82
	ControlResponseHeader = 0x84

	StateHeating = 0x83
	StateIdle    = 0x81
	StateOff     = 0x84

	CmdTypeMode = 0x04
	CmdTypeTemp = 0x03

	ValueHeatOn = 0x81
	ValueOff    = 0x00

	ReadBufferSize = 16
)

// BoilerStatus 보일???�태 구조�?type BoilerStatus struct {
	Room        byte
	State       byte
	CurrentTemp byte
	SetTemp     byte
}

// BoilerController 보일??컨트롤러 구조�?type BoilerController struct {
	port       *serial.Port
	portName   string
	mqttClient mqtt.Client
	mqttPrefix string

	statusQueryPackets [MaxRooms][]byte
	boilerStatus       [MaxRooms]byte

	serialMu sync.Mutex

	statusMu sync.RWMutex

	pauseQueryChan  chan struct{}
	resumeQueryChan chan struct{}
	isQueryPaused   bool
	queryPauseMu    sync.Mutex

	prevMode        [MaxRooms]byte
	prevCurrentTemp [MaxRooms]byte
	prevSetTemp     [MaxRooms]byte

	readBuffer  []byte
	topicBuffer strings.Builder
}

// NewBoilerController ?�로??보일??컨트롤러�??�성?�니??
func NewBoilerController(portName string, mqttBroker string, mqttPrefix string) (*BoilerController, error) {
	bc := &BoilerController{
		portName:        portName,
		mqttPrefix:      mqttPrefix,
		pauseQueryChan:  make(chan struct{}),
		resumeQueryChan: make(chan struct{}),
		readBuffer:      make([]byte, ReadBufferSize),
	}

	statusQueryStrings := [MaxRooms]string{
		"0201000000000003",
		"0202000000000004",
		"0203000000000005",
		"0204000000000006",
	}

	for i, hex := range statusQueryStrings {
		// utils.go???�는 hexStringToBytes ?�수�??�용?�니??
		bc.statusQueryPackets[i] = hexStringToBytes(hex)
	}

	for i := 0; i < MaxRooms; i++ {
		bc.prevMode[i] = 0xFF
		bc.prevCurrentTemp[i] = 0xFF
		bc.prevSetTemp[i] = 0xFF
	}

	if err := bc.initSerial(); err != nil {
		return nil, fmt.Errorf("?�리???�트 초기???�패: %w", err)
	}

	if err := bc.initMQTT(mqttBroker); err != nil {
		return nil, fmt.Errorf("MQTT 초기???�패: %w", err)
	}

	return bc, nil
}

// initSerial ?�리???�트�?초기?�하�??�결?�니??
func (bc *BoilerController) initSerial() error {
	// 무한 ?�연�??�도
	for {
		fmt.Printf("[BOILER] ?�리???�트 %s ?�결 ?�도 �?..\n", bc.portName)
		sp, err := openSerialPort(bc.portName)
		if err == nil {
			bc.port = sp
			fmt.Println("[BOILER] ?�리???�트 ?�결 ?�공!")
			return nil
		}
		fmt.Printf("[BOILER] ?�리???�트 ?�결 ?�패: %v. 3�????�시??..\n", err)
		time.Sleep(3 * time.Second)
	}
}

// reconnectSerialPort ?�리???�트 ?�연결을 ?�도?�니??
func (bc *BoilerController) reconnectSerialPort() {
	// ?��? lock???�태?�서 ?�출?????�으므�?defer�??�용?��? ?�음
	if bc.port != nil {
		bc.port.Close()
		bc.port = nil
	}

	// 무한 ?�연�??�도
	for {
		fmt.Printf("[BOILER] ?�리???�트 %s ?�연�??�도 �?..\n", bc.portName)
		sp, err := openSerialPort(bc.portName)
		if err == nil {
			bc.port = sp
			fmt.Println("[BOILER] ?�리???�트 ?�연�??�공!")
			return
		}
		fmt.Printf("[BOILER] ?�리???�트 ?�연�??�패: %v. 3�????�시??..\n", err)
		time.Sleep(3 * time.Second)
	}
}

// monitorSerialConnection ?�리???�트 ?�결 ?�태�?지?�적?�로 모니?�링?�니??
func (bc *BoilerController) monitorSerialConnection() {
	ticker := time.NewTicker(60 * time.Second) // 1분마??체크
	defer ticker.Stop()

	for {
		select {
		case <-ticker.C:
			if bc.port == nil {
				fmt.Println("[BOILER] ?�리???�트가 nil?�니?? ?�연�??�도...")
				bc.reconnectSerialPort()
			} else {
				// 간단???�결 ?�스??				testPacket := []byte{0x02, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x03}
				bc.serialMu.Lock()
				_, err := bc.port.Write(testPacket)
				bc.serialMu.Unlock()

				if err != nil {
					fmt.Printf("[BOILER] ?�리???�트 ?�결 ?�스???�패: %v. ?�연�??�도...\n", err)
					bc.reconnectSerialPort()
				} else {
					fmt.Println("[BOILER] ?�리???�트 ?�결 ?�태 ?�상")
				}
			}
		}
	}
}

// initMQTT MQTT ?�라?�언?��? 초기?�하�??�결?�니??
func (bc *BoilerController) initMQTT(mqttBroker string) error {
	defer func() {
		if r := recover(); r != nil {
			fmt.Printf("[BOILER] MQTT ?�결 �??�닉 복구: %v\n", r)
		}
	}()

	opts := mqtt.NewClientOptions().
		AddBroker(mqttBroker).
		SetClientID("usbrs485-boiler").
		SetCleanSession(false).                   // ?�션 ?��?�??�연�???구독 복원
		SetAutoReconnect(true).                   // ?�동 ?�연�??�성??		SetConnectRetry(true).                    // ?�결 ?�시???�성??		SetConnectRetryInterval(5 * time.Second). // ?�연�?간격
		SetMaxReconnectInterval(1 * time.Minute). // 최�? ?�연�?간격
		SetConnectionLostHandler(bc.onMQTTConnectionLost).
		SetOnConnectHandler(bc.onMQTTConnect).
		SetOrderMatters(false).             // 메시지 ?�서 무시�??�능 ?�상
		SetResumeSubs(true).                // ?�연�???구독 ?�동 복원
		SetKeepAlive(30 * time.Second).     // Keep-Alive 간격
		SetPingTimeout(10 * time.Second).   // Ping ?�?�아??		SetConnectTimeout(30 * time.Second) // ?�결 ?�?�아??
	bc.mqttClient = mqtt.NewClient(opts)

	// ?�결 ?�도 ?�에 ?�시 ?��?	time.Sleep(1 * time.Second)

	if token := bc.mqttClient.Connect(); token.Wait() && token.Error() != nil {
		return token.Error()
	}

	fmt.Println("[BOILER] MQTT ?�결 ?�공!")
	return nil
}

// onMQTTConnectionLost MQTT ?�결???�겼?????�출?�니??
func (bc *BoilerController) onMQTTConnectionLost(client mqtt.Client, err error) {
	defer func() {
		if r := recover(); r != nil {
			fmt.Printf("[BOILER] MQTT ?�결 ?��? ?�들???�닉 복구: %v", r)
		}
	}()

	fmt.Printf("[BOILER] MQTT ?�결 ?��?: %v. ?�동 ?�연�??�도 �?..", err)
}

// onMQTTConnect MQTT ?�결 ?�공 ???�출?�니?? (?�연�??�함)
func (bc *BoilerController) onMQTTConnect(client mqtt.Client) {
	defer func() {
		if r := recover(); r != nil {
			fmt.Printf("[BOILER] MQTT ?�결 ?�공 ?�들???�닉 복구: %v", r)
		}
	}()

	fmt.Println("[BOILER] MQTT ?�결 복구 ?�는 초기 ?�결 ?�료. 구독 ?�정 �?..")
	bc.setupMQTTSubscriptions()
}

// monitorMQTTConnection MQTT ?�결 ?�태�?지?�적?�로 모니?�링?�니??
func (bc *BoilerController) monitorMQTTConnection() {
	defer func() {
		if r := recover(); r != nil {
			fmt.Printf("[BOILER] MQTT 모니?�링 ?�닉 복구: %v", r)
		}
	}()

	ticker := time.NewTicker(30 * time.Second) // 30초마??체크
	defer ticker.Stop()

	for {
		select {
		case <-ticker.C:
			// MQTT ?�라?�언??nil 체크
			if bc.mqttClient == nil {
				fmt.Println("[BOILER] MQTT ?�라?�언?��? nil?�니?? 모니?�링??중단?�니??")
				return
			}

			// ?�결 ?�태 체크�??�전?�게 ?�행
			if !bc.mqttClient.IsConnected() {
				fmt.Println("[BOILER] MQTT ?�결???�어졌습?�다. ?�연�??�도 �?..")

				// ?�연�??�도 ?�에 ?�시 ?��?				time.Sleep(2 * time.Second)

				// ?�연�??�도
				if token := bc.mqttClient.Connect(); token.Wait() && token.Error() != nil {
					fmt.Printf("[BOILER] MQTT ?�연�??�패: %v", token.Error())
				} else {
					fmt.Println("[BOILER] MQTT ?�연�??�공!")
					// ?�연�???구독 ?�설??					time.Sleep(1 * time.Second)
					bc.setupMQTTSubscriptions()
				}
			} else {
				fmt.Println("[BOILER] MQTT ?�결 ?�태 ?�상")
			}
		}
	}
}

// Run 컨트롤러�??�행?�니??
func (bc *BoilerController) Run() {
	// MQTT ?�결 모니?�링 ?�작
	go bc.monitorMQTTConnection()

	// ?�리???�결 모니?�링 ?�작
	go bc.monitorSerialConnection()

	bc.setupMQTTSubscriptions()

	// 초기 ?�태 발행
	bc.publishInitialStates()

	bc.startStatusMonitoring()

	select {}
}

// publishInitialStates 초기 ?�태�?MQTT??발행?�니??
func (bc *BoilerController) publishInitialStates() {
	fmt.Println("[BOILER] 초기 ?�태 발행 ?�작...")

	for room := 1; room <= MaxRooms; room++ {
		// 기본값으�?초기 ?�태 발행
		bc.publishMQTTOptimized("mode", room, "off")
		bc.publishMQTTOptimized("current_temperature", room, "00")
		bc.publishMQTTOptimized("set_temperature", room, "00")

		fmt.Printf("[BOILER] �?%d 초기 ?�태 발행 ?�료", room)
	}

	fmt.Println("[BOILER] 초기 ?�태 발행 ?�료!")
}

// setupMQTTSubscriptions MQTT 구독???�정?�니??
func (bc *BoilerController) setupMQTTSubscriptions() {
	defer func() {
		if r := recover(); r != nil {
			fmt.Printf("[BOILER] MQTT 구독 ?�닉 복구: %v", r)
		}
	}()

	// MQTT ?�라?�언??nil 체크
	if bc.mqttClient == nil {
		fmt.Println("[BOILER] MQTT ?�라?�언?��? nil?�니?? 구독??건너?�니??")
		return
	}

	for room := 1; room <= MaxRooms; room++ {
		bc.subscribeModeCommands(room)
		bc.subscribeTemperatureCommands(room)
	}
}

// subscribeModeCommands 모드 명령 구독???�정?�니??
func (bc *BoilerController) subscribeModeCommands(room int) {
	bc.topicBuffer.Reset()
	bc.topicBuffer.WriteString(bc.mqttPrefix)
	bc.topicBuffer.WriteString("/boilers/")
	bc.topicBuffer.WriteString(strconv.Itoa(room))
	bc.topicBuffer.WriteString("/mode/set")
	topic := bc.topicBuffer.String()

	token := bc.mqttClient.Subscribe(topic, 1, func(client mqtt.Client, msg mqtt.Message) {
		bc.handleModeCommand(room, topic, msg.Payload())
	})
	token.Wait()
	if token.Error() != nil {
		fmt.Printf("[MQTT] 모드 구독 ?�패 (%s): %v", topic, token.Error())
	} else {
		fmt.Printf("[MQTT] 모드 구독 ?�공: %s", topic)
	}
}

// subscribeTemperatureCommands ?�도 명령 구독???�정?�니??
func (bc *BoilerController) subscribeTemperatureCommands(room int) {
	bc.topicBuffer.Reset()
	bc.topicBuffer.WriteString(bc.mqttPrefix)
	bc.topicBuffer.WriteString("/boilers/")
	bc.topicBuffer.WriteString(strconv.Itoa(room))
	bc.topicBuffer.WriteString("/temperature/set")
	topic := bc.topicBuffer.String()

	token := bc.mqttClient.Subscribe(topic, 1, func(client mqtt.Client, msg mqtt.Message) {
		bc.handleTemperatureCommand(room, topic, msg.Payload())
	})
	token.Wait()
	if token.Error() != nil {
		fmt.Printf("[MQTT] ?�도 구독 ?�패 (%s): %v", topic, token.Error())
	} else {
		fmt.Printf("[MQTT] ?�도 구독 ?�공: %s", topic)
	}
}

// handleModeCommand 모드 명령??처리?�니??
func (bc *BoilerController) handleModeCommand(room int, topic string, payload []byte) {
	fmt.Printf("[MQTT] 모드 명령 ?�신: topic=%s, payload=%s", topic, payload)

	var isHeatCmd, isOffCmd bool
	if strings.EqualFold(string(payload), "heat") {
		isHeatCmd = true
	} else if strings.EqualFold(string(payload), "off") {
		isOffCmd = true
	}

	bc.statusMu.RLock()
	currentBoilerState := bc.boilerStatus[room-1]
	bc.statusMu.RUnlock()

	var packet []byte
	switch {
	case isHeatCmd && currentBoilerState == 0:
		packet = bc.makeBoilerPacket(room, CmdTypeMode, ValueHeatOn)
	case isOffCmd && currentBoilerState == 1:
		packet = bc.makeBoilerPacket(room, CmdTypeMode, ValueOff)
	default:
		fmt.Println("[MQTT] 모드 명령 무시: ?��? ?�당 ?�태?�거???�못??명령")
		return
	}

	bc.sendCommandAndQuery(packet)
}

// handleTemperatureCommand ?�도 명령??처리?�니??
func (bc *BoilerController) handleTemperatureCommand(room int, topic string, payload []byte) {
	payloadStr := string(payload)
	payloadStr = strings.TrimSpace(payloadStr)
	if dot := strings.Index(payloadStr, "."); dot != -1 {
		payloadStr = payloadStr[:dot]
	}

	val, err := strconv.ParseInt(payloadStr, 16, 0)
	fmt.Printf("[MQTT] ?�도 ?�정 명령 ?�신: topic=%s, payload=%s, val=0x%X", topic, payloadStr, val)

	if err != nil {
		fmt.Printf("[MQTT] ?�도 명령 무시: ?�자 변???�패 - %v", err)
		return
	}
	if byte(val) < MinTemp || byte(val) > MaxTemp {
		fmt.Printf("[MQTT] ?�도 명령 무시: ?�용 범위 (0x%X ~ 0x%X) ??- 0x%X", MinTemp, MaxTemp, byte(val))
		return
	}

	packet := bc.makeBoilerPacket(room, CmdTypeTemp, byte(val))
	bc.sendCommandAndQuery(packet)
}

// sendCommandAndQuery 명령???�송?�고 모든 방의 ?�태�?조회?�니??
func (bc *BoilerController) sendCommandAndQuery(packet []byte) {
	fmt.Printf("[RS485] 보낼 명령 ?�킷: % X", packet)

	bc.queryPauseMu.Lock()
	if !bc.isQueryPaused {
		select {
		case bc.pauseQueryChan <- struct{}{}:
			bc.isQueryPaused = true
			fmt.Println("[RS485] ?�태 쿼리 ?�시 중�? ?�청")
		default:
			fmt.Println("[RS485] ?�태 쿼리 ?�시 중�? ?�청 무시: ?��? ?�시 중�? ?�태?�거??채널??가??�?)
		}
	}
	bc.queryPauseMu.Unlock()

	bc.serialMu.Lock()

	if bc.port == nil {
		fmt.Println("[BOILER] ?�리???�트가 ?�결?��? ?�아 명령 ?�송 불�?. ?�연�??�도...")
		bc.serialMu.Unlock()
		bc.reconnectSerialPort()
		if bc.port == nil {
			fmt.Println("[BOILER] ?�리???�트 ?�연�??�패. 명령 ?�송 중단.")
			return
		}
		bc.serialMu.Lock()
	}

	_, err := bc.port.Write(packet)
	if err != nil {
		fmt.Printf("[BOILER] ?�리???�트 ?�기 ?�러 발생: %v. ?�연�??�도...", err)
		bc.serialMu.Unlock()
		bc.reconnectSerialPort()
		if bc.port == nil {
			fmt.Println("[BOILER] ?�리???�트 ?�연�??�패. 명령 ?�송 중단.")
			return
		}
		bc.serialMu.Lock()
	}
	time.Sleep(CommandDelay)

	for i := 0; i < MaxRooms; i++ {
		_, err := bc.port.Write(bc.statusQueryPackets[i])
		if err != nil {
			fmt.Printf("[BOILER] ?�리???�트 ?�기 ?�러 (?�태 쿼리 �?: %v. ?�연�??�도...", err)
			bc.serialMu.Unlock()
			bc.reconnectSerialPort()
			if bc.port == nil {
				fmt.Println("[BOILER] ?�리???�트 ?�연�??�패. ?�태 쿼리 중단.")
				break
			}
			bc.serialMu.Lock()
			continue
		}

		n, err := bc.port.Read(bc.readBuffer)
		if err != nil {
			fmt.Printf("[BOILER] ?�리???�트 ?�기 ?�러 (?�태 쿼리 �?: %v. ?�연�??�도...", err)
			bc.serialMu.Unlock()
			bc.reconnectSerialPort()
			if bc.port == nil {
				fmt.Println("[BOILER] ?�리???�트 ?�연�??�패. ?�태 쿼리 중단.")
				break
			}
			bc.serialMu.Lock()
			continue
		}

		if n >= 8 {
			bc.processStatusResponse(bc.readBuffer[:n])
		} else {
			fmt.Printf("[RS485] 불완?�한 ?�태 ?�답 ?�신 (길이 %d): % X", n, bc.readBuffer[:n])
		}
		time.Sleep(StatusQueryDelay)
	}

	bc.serialMu.Unlock()

	bc.queryPauseMu.Lock()
	if bc.isQueryPaused {
		select {
		case bc.resumeQueryChan <- struct{}{}:
			bc.isQueryPaused = false
			fmt.Println("[RS485] ?�태 쿼리 ?�개 ?�청")
		default:
			fmt.Println("[RS485] ?�태 쿼리 ?�개 ?�청 무시: ?��? ?�개 ?�태?�거??채널??가??�?)
		}
	}
	bc.queryPauseMu.Unlock()
}

// startStatusMonitoring ?�태 모니?�링 고루?�을 ?�작?�니??
func (bc *BoilerController) startStatusMonitoring() {
	go func() {
		for {
			bc.queryPauseMu.Lock()
			isPaused := bc.isQueryPaused
			bc.queryPauseMu.Unlock()

			if isPaused {
				fmt.Println("[RS485] ?�태 쿼리 루프 ?�시 중�??? ?�개 ?�호 ?��?�?..")
				<-bc.resumeQueryChan
				fmt.Println("[RS485] ?�태 쿼리 루프 ?�개??")
			}

			bc.serialMu.Lock()
			if bc.port == nil {
				fmt.Println("[BOILER] ?�태 쿼리 �??�리???�트 ?�결 ?�음. ?�연�??�도...")
				bc.serialMu.Unlock()
				bc.reconnectSerialPort()
				time.Sleep(StatusQueryDelay)
				continue
			}

			for i := 0; i < MaxRooms; i++ {
				_, err := bc.port.Write(bc.statusQueryPackets[i])
				if err != nil {
					fmt.Printf("[BOILER] ?�태 쿼리 �??�리???�트 ?�기 ?�러: %v. ?�연�??�도...", err)
					bc.serialMu.Unlock()
					bc.reconnectSerialPort()
					time.Sleep(StatusQueryDelay)
					break
				}

				n, err := bc.port.Read(bc.readBuffer)
				if err != nil {
					fmt.Printf("[BOILER] ?�태 쿼리 �??�리???�트 ?�기 ?�러: %v. ?�연�??�도...", err)
					bc.serialMu.Unlock()
					bc.reconnectSerialPort()
					time.Sleep(StatusQueryDelay)
					break
				}

				if n >= 8 {
					bc.processStatusResponse(bc.readBuffer[:n])
				} else {
					fmt.Printf("[RS485] 불완?�한 ?�태 ?�답 ?�신 (길이 %d): % X", n, bc.readBuffer[:n])
				}
				time.Sleep(StatusQueryDelay)
			}
			bc.serialMu.Unlock()

			time.Sleep(StatusQueryDelay * 2)
		}
	}()
}

// processStatusResponse ?�신???�태 ?�답 ?�킷??처리?�니??
func (bc *BoilerController) processStatusResponse(data []byte) {
	fmt.Printf("[RS485] ?�신 ?�킷: % X", data)

	status := bc.parseBoilerStatusPacket(data)
	if status.Room == 0 || status.Room > MaxRooms {
		fmt.Printf("[RS485] ?�효?��? ?��? 보일???�태 ?�킷: %X", data)
		return
	}

	idx := status.Room - 1

	bc.statusMu.Lock()
	if status.State == StateHeating || status.State == StateIdle {
		bc.boilerStatus[idx] = 1
	} else {
		bc.boilerStatus[idx] = 0
	}
	bc.statusMu.Unlock()

	var mode string
	if status.State == StateHeating || status.State == StateIdle {
		mode = "heat"
	} else {
		mode = "off"
	}

	fmt.Printf("[�?%d] 모드: %s, ?�재?�도: %X, ?�정?�도: %X",
		status.Room, mode, status.CurrentTemp, status.SetTemp)

	// �?번째 ?�효???�이?�인 경우 즉시 발행
	if bc.prevMode[idx] == 0xFF {
		fmt.Printf("[BOILER] �?%d �?번째 ?�효???�이???�신, 즉시 발행", status.Room)
		bc.publishMQTTOptimized("mode", int(status.Room), mode)
		bc.publishMQTTOptimized("current_temperature", int(status.Room), fmt.Sprintf("%X", status.CurrentTemp))
		bc.publishMQTTOptimized("set_temperature", int(status.Room), fmt.Sprintf("%X", status.SetTemp))

		// 초기�??�정
		bc.prevMode[idx] = 0
		if mode == "heat" {
			bc.prevMode[idx] = 1
		}
		bc.prevCurrentTemp[idx] = status.CurrentTemp
		bc.prevSetTemp[idx] = status.SetTemp
		return
	}

	bc.publishStatusIfChanged(status, int(idx), mode)
}

// publishStatusIfChanged ?�태 변�??�에�?MQTT 메시지�?발행?�니??
func (bc *BoilerController) publishStatusIfChanged(status BoilerStatus, idx int, mode string) {
	var modeChanged, currentTempChanged, setTempChanged bool

	var modeCode byte
	if mode == "heat" {
		modeCode = 1
	} else {
		modeCode = 0
	}

	if bc.prevMode[idx] != modeCode {
		modeChanged = true
		bc.prevMode[idx] = modeCode
	}

	if bc.prevCurrentTemp[idx] != status.CurrentTemp {
		currentTempChanged = true
		bc.prevCurrentTemp[idx] = status.CurrentTemp
	}

	if bc.prevSetTemp[idx] != status.SetTemp {
		setTempChanged = true
		bc.prevSetTemp[idx] = status.SetTemp
	}

	if modeChanged {
		bc.publishMQTTOptimized("mode", int(status.Room), mode)
	}

	if currentTempChanged {
		bc.publishMQTTOptimized("current_temperature", int(status.Room), fmt.Sprintf("%X", status.CurrentTemp))
	}

	if setTempChanged {
		bc.publishMQTTOptimized("set_temperature", int(status.Room), fmt.Sprintf("%X", status.SetTemp))
	}
}

// publishMQTTOptimized 최적?�된 MQTT 메시지 발행 ?�수.
func (bc *BoilerController) publishMQTTOptimized(msgType string, room int, payload string) {
	bc.topicBuffer.Reset()
	bc.topicBuffer.WriteString(bc.mqttPrefix)
	bc.topicBuffer.WriteString("/boilers/")
	bc.topicBuffer.WriteString(strconv.Itoa(room))
	bc.topicBuffer.WriteByte('/')
	bc.topicBuffer.WriteString(msgType)
	topic := bc.topicBuffer.String()

	fmt.Printf("[MQTT] ?�태 publish: topic=%s, payload=%s", topic, payload)
	token := bc.mqttClient.Publish(topic, 0, false, payload)
	token.Wait()
	if token.Error() != nil {
		fmt.Printf("[MQTT] ?�태 publish ?�패 (%s): %v", topic, token.Error())
	}
}

// parseBoilerStatusPacket 보일???�태 ?�킷???�싱?�니??
func (bc *BoilerController) parseBoilerStatusPacket(pkt []byte) BoilerStatus {
	if len(pkt) < 8 {
		fmt.Printf("[RS485] ?�킷 길이 부�? % X", pkt)
		return BoilerStatus{}
	}

	var sum byte = 0
	for i := 0; i < 7; i++ {
		sum += pkt[i]
	}
	if pkt[7] != sum {
		fmt.Printf("[RS485] 체크??불일�?(계산: 0x%X, ?�신: 0x%X): % X", sum, pkt[7], pkt)
		return BoilerStatus{}
	}

	if pkt[0] != StatusResponseHeader && pkt[0] != ControlResponseHeader {
		fmt.Printf("[RS485] ?�효?��? ?��? ?�더 (0x%X): % X", pkt[0], pkt)
		return BoilerStatus{}
	}

	return BoilerStatus{
		Room:        pkt[2],
		State:       pkt[1],
		CurrentTemp: pkt[3],
		SetTemp:     pkt[4],
	}
}

// makeBoilerPacket 보일???�어 ?�킷???�성?�니??
func (bc *BoilerController) makeBoilerPacket(deviceID int, cmdType byte, value byte) []byte {
	pkt := []byte{
		0x04,
		byte(deviceID),
		cmdType,
		value,
		0x00, 0x00, 0x00,
		0x00,
	}

	var sum byte = 0
	for i := 0; i < 7; i++ {
		sum += pkt[i]
	}
	pkt[7] = sum

	return pkt
}

// RunBoilerController??메인 ?�수?�서 보일??컨트롤러�??�행?�니??
// ???�수??boiler.go ?�일??package main???�해?�으�? main.go?�서 직접 ?�출?�니??
func RunBoilerController(portName, mqttBroker, mqttPrefix string) {
	bc, err := NewBoilerController(portName, mqttBroker, mqttPrefix)
	if err != nil {
		fmt.Printf("[BOILER] 컨트롤러 ?�성 ?�패: %v", err) // 치명???�류�??�로그램 종료
	}
	bc.Run()
}

// openSerialPort ?�리???�트�??�고 ?�정?�니??
func openSerialPort(portName string) (*serial.Port, error) {
	// ?��??�이??모드 체크
	if len(portName) >= 4 && portName[:4] == "SIM_" {
		fmt.Printf("[BOILER] ?��??�이??모드: %s ?�트 ?�용", portName)
		return &serial.Port{}, nil // 가???�트 반환
	}

	config := &serial.Config{
		Name:        portName,
		Baud:        SerialBaudRate,
		Size:        8,
		Parity:      serial.ParityNone,
		StopBits:    serial.Stop1,
		ReadTimeout: SerialReadTimeout,
	}
	return serial.OpenPort(config)
}
